package com.example.thesosgame.ui.screens

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.text.selection.SelectionContainer
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.Close
import androidx.compose.material.icons.filled.Refresh
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.compose.ui.window.Dialog
import com.example.thesosgame.network.RoomManager
import com.example.thesosgame.ui.theme.Primary
import kotlinx.coroutines.launch

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun NetworkDiagnosticsDialog(
    roomManager: RoomManager,
    onDismiss: () -> Unit
) {
    var diagnostics by remember { mutableStateOf("Loading...") }
    var isRefreshing by remember { mutableStateOf(false) }
    val scope = rememberCoroutineScope()
    
    fun refreshDiagnostics() {
        scope.launch {
            isRefreshing = true
            diagnostics = roomManager.getNetworkDiagnostics()
            isRefreshing = false
        }
    }
    
    LaunchedEffect(Unit) {
        refreshDiagnostics()
    }
    
    Dialog(onDismissRequest = onDismiss) {
        ElevatedCard(
            modifier = Modifier
                .fillMaxWidth()
                .fillMaxHeight(0.8f)
                .padding(16.dp),
            shape = RoundedCornerShape(24.dp)
        ) {
            Column(
                modifier = Modifier.padding(24.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                // Header
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        text = "Network Diagnostics",
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Row {
                        IconButton(
                            onClick = { refreshDiagnostics() },
                            enabled = !isRefreshing
                        ) {
                            Icon(Icons.Default.Refresh, contentDescription = "Refresh")
                        }
                        IconButton(onClick = onDismiss) {
                            Icon(Icons.Default.Close, contentDescription = "Close")
                        }
                    }
                }
                
                if (isRefreshing) {
                    Box(
                        modifier = Modifier.fillMaxWidth(),
                        contentAlignment = Alignment.Center
                    ) {
                        CircularProgressIndicator()
                    }
                } else {
                    SelectionContainer {
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            colors = CardDefaults.cardColors(
                                containerColor = MaterialTheme.colorScheme.surfaceVariant
                            )
                        ) {
                            Text(
                                text = diagnostics,
                                modifier = Modifier.padding(16.dp),
                                fontSize = 12.sp,
                                fontFamily = FontFamily.Monospace,
                                lineHeight = 16.sp
                            )
                        }
                    }
                }
                
                // Test buttons
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceEvenly
                ) {
                    Button(
                        onClick = {
                            scope.launch {
                                try {
                                    val deviceIP = roomManager.getDeviceIP()
                                    if (deviceIP != null) {
                                        val testResult = roomManager.testConnection(deviceIP)
                                        diagnostics += "\n\n=== LOCAL TEST ===\n$testResult"
                                    }
                                } catch (e: Exception) {
                                    diagnostics += "\n\n=== LOCAL TEST FAILED ===\n${e.message}"
                                }
                            }
                        },
                        colors = ButtonDefaults.buttonColors(containerColor = Primary)
                    ) {
                        Text("Test Local", fontSize = 12.sp)
                    }
                    
                    OutlinedButton(
                        onClick = {
                            // Show link test dialog
                            scope.launch {
                                diagnostics += "\n\n=== LINK TEST ===\nUse the Link Test dialog to verify custom URL handling"
                            }
                        }
                    ) {
                        Text("Link Test", fontSize = 12.sp)
                    }
                }
            }
        }
    }
}
